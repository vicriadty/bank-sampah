@startuml
!theme plain
skinparam monochrome true
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor black

title Flowchart Transaksi Setor Sampah

start
partition "Alur Create Setoran" {
  :Admin: Membuka halaman setoran;
  :Sistem: Menampilkan form (Pilih Nasabah, Pilih Sampah, Input Berat);
  :Admin: Pilih Nasabah via Select2;
  :Admin: Pilih Jenis Sampah;

  :Sistem: AJAX GET /get-sampah-by-jenis/{id}
  Memuat daftar Sampah;

  :Admin: Pilih Sampah + Input Berat (kg);
  :Sistem: JavaScript auto-hitung subtotal & total_harga;
  :Admin: Klik tombol Simpan;
  :Sistem: Tampilkan SweetAlert konfirmasi;

  if (Admin konfirmasi?) then (Ya)

    :Sistem: Validasi input
    (nasabah_id exists, berat >= 0.1);

    if (Valid?) then (Ya)

      :Sistem: DB::beginTransaction();
      :DB: lockForUpdate pada Sampah & DompetNasabah;
      :Sistem: Create Setoran (status: 'berhasil');
      :Sistem: Loop tiap item Sampah;

      partition "Per Item" {
        :Sistem: Create SetoranDetail;
        :DB: Increment stok Sampah (+berat);
      }

      :Sistem: Update total_harga Setoran;
      :DB: Increment saldo_rupiah DompetNasabah (+total_harga);

      if (Sukses?) then (Ya)
        :DB: commit;
        :Sistem: Redirect + Toast sukses;
      else (Tidak)
        :DB: rollback;
        :Sistem: SweetAlert error;
      endif

    else (Tidak)
      :Sistem: SweetAlert error
      (Data tidak valid);
    endif

  else (Tidak)
    :Sistem: Kembali ke form input;
  endif
}

partition "Alur Void / Batalkan Setoran" {
  :Admin: Klik tombol void (merah)
  pada baris setoran;
  :Sistem: Tampilkan modal
  "Alasan Pembatalan";
  :Admin: Input alasan + klik Submit;
  :Sistem: Validasi (alasan tidak kosong,
  status setoran == 'berhasil');

  if (Valid?) then (Ya)

    :Sistem: DB::beginTransaction();
    :DB: lockForUpdate pada Setoran,
    Sampah & DompetNasabah;

    :Sistem: Loop tiap SetoranDetail;

    partition "Per Item" {
      :DB: Cek stok Sampah >= detail.berat;
      :DB: Decrement stok Sampah (-berat);
    }

    :DB: Cek saldo_rupiah >= total_harga;
    :DB: Decrement saldo_rupiah
    DompetNasabah (-total_harga);

    :Sistem: Update Setoran
    (status: 'dibatalkan',
    alasan_batal: ...);

    if (Sukses?) then (Ya)
      :DB: commit;
      :Sistem: Redirect + Toast sukses;
    else (Tidak)
      :DB: rollback;
      :Sistem: Redirect + Toast error;
    endif

  else (Tidak)
    :Sistem: Tampilkan error;
  endif
}

partition "Alur Cetak Laporan PDF" {
  :Admin: Filter (tanggal / nasabah);
  :Admin: Klik "Cetak Laporan";
  :Sistem: Query Setoran + filter;
  :Sistem: DomPDF render laporan;
  :Sistem: Download file .pdf;
}

stop
@enduml
